---
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  markdownUrl?: string;
  lastUpdated?: Date;
  publishedAt?: Date;
}

const { markdownUrl, lastUpdated, publishedAt, class: className, ...attrs } = Astro.props;

const baseBtn =
  "inline-flex cursor-pointer items-center gap-1.5 rounded-md bg-transparent px-2 py-1 text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2";

const formatDate = (value: Date) =>
  new Intl.DateTimeFormat(undefined, {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(value);

const publishedLabel = publishedAt ? formatDate(publishedAt) : null;
const updatedLabel = lastUpdated ? formatDate(lastUpdated) : null;
const showUpdated =
  Boolean(lastUpdated) &&
  (!publishedAt || lastUpdated!.toISOString().slice(0, 10) !== publishedAt.toISOString().slice(0, 10));
---

{(markdownUrl || publishedAt || lastUpdated) && (
  <div
    data-nb-page-actions
    data-md-url={markdownUrl}
    class={cn("not-prose -ml-2 flex flex-wrap items-center gap-y-1 text-[0.8125rem]", className)}
    {...attrs}
  >
    {publishedAt && (
      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-muted-foreground">
        <Icon name="ph:calendar-blank" class="w-3.5 h-3.5" />
        Published <time datetime={publishedAt.toISOString()}>{publishedLabel}</time>
      </span>
    )}

    {publishedAt && showUpdated && (
      <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>
    )}

    {showUpdated && lastUpdated && (
      <span class="inline-flex items-center gap-1.5 px-2 py-1 text-muted-foreground">
        <Icon name="ph:clock" class="w-3.5 h-3.5" />
        Updated <time datetime={lastUpdated.toISOString()}>{updatedLabel}</time>
      </span>
    )}

    {(publishedAt || lastUpdated) && markdownUrl && (
      <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>
    )}

    {markdownUrl && (
      <>
        <button type="button" data-nb-page-actions-copy class={baseBtn}>
          <Icon name="ph:copy" class="w-3.5 h-3.5" data-nb-page-actions-copy-icon is:inline />
          <Icon name="ph:check" class="hidden w-3.5 h-3.5 text-success" data-nb-page-actions-check-icon is:inline />
          <span data-nb-page-actions-label aria-live="polite">Copy page</span>
        </button>

        <span aria-hidden="true" class="select-none text-muted-foreground/40">|</span>

        <a
          href={markdownUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={baseBtn}
        >
          <Icon name="ph:markdown-logo" class="w-3.5 h-3.5" />
          View as Markdown
        </a>
      </>
    )}
  </div>
)}

<script>
  import "./page-actions.client";
</script>
