{
  "name": "eazy-review-lab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "validate:publication": "node scripts/validate-publication.mjs",
    "test:public": "node scripts/test-public-behavior.mjs",
    "test:project-health": "node --test scripts/tests/*.test.mjs",
    "evidence:refresh": "node scripts/refresh-github-evidence.mjs",
    "visuals:project-health": "node scripts/build-project-health-visuals.mjs",
    "check:generated-assets": "node scripts/check-generated-assets.mjs",
    "validate:project-health": "node scripts/validate-project-health.mjs",
    "check": "astro check && node scripts/validate-publication.mjs && node scripts/validate-project-health.mjs && node --test scripts/tests/*.test.mjs && node scripts/check-generated-assets.mjs && astro build && nimbus-docs lint && node scripts/test-public-behavior.mjs",
    "prepreview:cf": "astro build",
    "preview:cf": "wrangler dev",
    "predeploy": "pnpm run check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.8.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "astro": "^7.0.0",
    "astro-icon": "^1.1.0",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@tailwindcss/vite": "^4.1.4",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.95.0"
  },
  "packageManager": "pnpm@11.17.0"
}
